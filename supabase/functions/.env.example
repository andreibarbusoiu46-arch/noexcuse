# Set with: supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically on the hosted platform.)
OPENAI_API_KEY=sk-...
# Any vision-capable model available to your OpenAI account. Pick and test before launch.
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low
REVENUECAT_SECRET_KEY=sk_...
# Exact value you also paste into RevenueCat › Integrations › Webhooks › Authorization header
REVENUECAT_WEBHOOK_AUTH=Bearer some-long-random-string
# Same value stored in Vault as 'cron_secret' (see supabase/sql/schedule_cron.sql)
CRON_SECRET=another-long-random-string
# Optional: Expo push security (expo.dev › Access tokens) if you enable enhanced push security
EXPO_ACCESS_TOKEN=
