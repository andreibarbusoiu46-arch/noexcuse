# Copy to .env and fill in. Only PUBLIC values go here — they ship inside the app.
# Secrets (OpenAI key, RevenueCat secret key, service role) go in Supabase function secrets, never here.

# Supabase › Project Settings › API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# RevenueCat › Project › API keys (public SDK keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_OFFERING=default

# Legal pages shown on the paywall and in Profile (required by App Review)
EXPO_PUBLIC_TERMS_URL=https://www.apple.com/legal/internet-services/itunes/dev/stdeula/
EXPO_PUBLIC_PRIVACY_URL=https://YOUR-SITE/privacy

# 1 = fixture data, no backend, no purchases (design review / Expo Go). Never ship with 1.
EXPO_PUBLIC_DEMO=0
