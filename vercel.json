{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/:screen(achievements|ai|ai-usage|arena|billing|challenges|coach|discipline|habits|onboarding|partners|paywall|profile|reports|reset-password|settings|share|sign-in)",
      "destination": "/app.html"
    },
    {
      "source": "/:section(appeal|auth|challenge|comeback|habit|missed|proof)/:rest+",
      "destination": "/app.html"
    }
  ]
}
